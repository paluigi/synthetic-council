# Copy to .env.local and fill in. Nothing here is needed for the keyless
# data pipeline (scripts/collect_all.py); only the LLM-dependent steps need
# keys.

# Jev (typesafe-ai/jev) via the Vercel AI Gateway — required for all
# simulation runs and the decision-mode extraction.
AI_GATEWAY_API_KEY=

# Tavily search API — per-trait member profile evidence
# (scripts/build_profiles.py).
TAVILY_API_KEY=

# TinyFish (agent.tinyfish.ai/api-keys) — press-coverage speech layer for
# 2024+ gaps (collectors/press_speeches.py; search + fetch are free).
# Export it before running: set -a; source .env.local; set +a
TINYFISH_API_KEY=

# Optional: statements via any OpenAI-compatible endpoint instead of the
# gateway (vLLM, Ollama, OpenRouter, ...). Used when --generator openai_compat.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
