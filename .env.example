# Copy to .env.local and fill in. Nothing here is needed for the keyless
# data pipeline (scripts/collect_all.py); only the LLM-dependent steps need
# keys.

# --- LLM inference (providers/models live in inference.toml) -------------
# Extractor/judge: cloudflare/clef via OpenRouter. Generator: GLM-5.3-Flash
# via Featherless. Export before running LLM steps:
#   set -a; source .env.local; set +a
OPENROUTER_API_KEY=
FEATHERLESS_API_KEY=

# Tavily search API — per-trait member profile evidence
# (scripts/build_profiles.py).
TAVILY_API_KEY=

# TinyFish (agent.tinyfish.ai/api-keys) — press-coverage speech layer for
# 2024+ gaps (collectors/press_speeches.py; search + fetch are free).
TINYFISH_API_KEY=
