% ---------- LLM agents simulating humans and committees ----------

@unpublished{kazinnik2025fomc,
  title = {{FOMC} In Silico: A Multi-Agent System for Monetary Policy Decision Modeling},
  author = {Kazinnik, Sophia and Sinclair, Tara M.},
  year = {2025},
  note = {SSRN Working Paper 5424097 / GW Department of Economics Working Paper 2025-005},
  doi = {10.2139/ssrn.5424097},
  summary = {Closest antecedent: LLM multi-agent FOMC simulation plus a Monte Carlo Bayesian voting benchmark, both seeded with member priors from real-time data and member profiles. Our ECB analogue differs by anchoring on the verbatim Chief Economist proposal and by measuring consensus rather than the rate level.}
}

@unpublished{hansen2025spf,
  title = {Simulating the Survey of Professional Forecasters},
  author = {Hansen, Anne Lundgaard and Horton, John J. and Kazinnik, Sophia and Puzzello, Daniela and Zarifhonarvar, Shakked},
  year = {2025},
  note = {SSRN Working Paper 5066286},
  doi = {10.2139/ssrn.5066286},
  summary = {Synthetic forecaster personas built with LLMs replicate key features of the human SPF distribution. Evidence that persona-conditioned LLM agents can track aggregate human panel data; motivates our within-persona memo design.}
}

@article{park2023generative,
  title = {Generative Agents: Interactive Simulacra of Human Behavior},
  author = {Park, Joon Sung and O'Brien, Joseph and Cai, Carrie Jun and Morris, Meredith Ringel and Liang, Percy and Bernstein, Michael S.},
  year = {2023},
  journal = {Proceedings of the 36th Annual ACM Symposium on User Interface Software and Technology},
  doi = {10.1145/3586183.3606763},
  summary = {Foundational generative-agents architecture: persona, memory, and reflection. The template for LLM agents that behave as plausible individuals rather than average responders.}
}

@unpublished{seok2024minifed,
